        "back":  { "text": "a", "audio": "media/audio/a.mp3" }
      },
      "skills": ["vocab.hiragana", "reading.basic"]
    },
    {
      "type": "exercise",
      "exerciseType": "multipleChoice",
      "prompt": "「い」 harfinin okunuşu hangisidir?",
