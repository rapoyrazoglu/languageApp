# HTTP
HTTP_ADDR=:8080

# Postgres
DATABASE_URL=postgres://langapp:langapp_dev@localhost:5432/langapp?sslmode=disable

# Object storage (S3-compatible)
# - AWS: leave S3_ENDPOINT / S3_ACCESS_KEY / S3_SECRET_KEY empty. The SDK will
#   pick credentials from the EC2 IAM instance role and use the default S3 host.
#   Set S3_USE_PATH_STYLE=false.
# - MinIO / R2: set all of them as below.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=packs
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_PATH_STYLE=true

# GitHub (optional — increases API rate limit)
GITHUB_TOKEN=

# GitHub webhook receiver (optional). Set this to the same value you put
# in the repo's webhook config. Empty disables /v1/webhooks/github.
GITHUB_WEBHOOK_SECRET=

# JWT (REQUIRED, must be >= 32 chars). Generate with: openssl rand -base64 48
JWT_SECRET=replace_me_with_a_random_string_of_at_least_32_chars
JWT_TTL_HOURS=24

# Limits
MAX_PACK_SIZE_BYTES=524288000   # 500 MB

# Rate limits (token bucket per IP/user)
RATE_LIMIT_ANON_PER_MIN=60
RATE_LIMIT_USER_PER_MIN=600
